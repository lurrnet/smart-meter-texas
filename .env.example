SMT_USERNAME=your_smt_username_or_email
SMT_PASSWORD=your_smt_password
SMT_ESIID=your_esiid
SMT_PROJECT_ROOT=/app
SMT_TIMEZONE=America/Chicago
SMT_REFRESH_TIME=11:00
SMT_OVERLAP_DAYS=7
SMT_RUN_ON_START=0

# Optional app-level HTTP Basic auth. Enabled by default (fail-closed).
# Set SMT_WEB_AUTH_ENABLED=false ONLY when a trusted upstream proxy such as
# Cloudflare Zero Trust Access enforces login on every app URL, including /api/*.
# Direct access to port 8090 must be blocked from untrusted networks.
SMT_WEB_AUTH_ENABLED=true
# Required only when SMT_WEB_AUTH_ENABLED=true. Password must be 16+ characters.
SMT_WEB_USERNAME=admin
SMT_WEB_PASSWORD=

# Privacy: raw interval API payloads are NOT stored unless explicitly enabled.
# These include meter identifiers and detailed usage; use only for temporary troubleshooting.
SMT_SAVE_RAW_PAYLOADS=0
